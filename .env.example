PORT=5173
JWT_SECRET=change-me

# Postgres (Supabase). DATABASE_URL = pooler connection used by the app at
# request time. DIRECT_URL is only needed if you later add a migration tool
# that requires a non-pooled connection; the app itself does not use it.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.ukkvqxbsznognohbvija:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.ukkvqxbsznognohbvija:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Supabase Storage, used for uploaded photos/videos/audio instead of local
# disk (local disk is not writable on Vercel). Create a PUBLIC bucket named
# framie-uploads (or set SUPABASE_STORAGE_BUCKET) and use the SERVICE ROLE
# key here (Project Settings -> API), not the anon key — uploads happen
# server-side and need to bypass storage RLS policies.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=framie-uploads
SUPABASE_ANON_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NFC_ENCRYPTION_SECRET=replace-with-a-long-random-secret
